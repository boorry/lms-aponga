# ──────────────────────────────────────────────────────────────
# Variables ajoutées/clarifiées lors de l'audit final (FINAL_AUDIT.md) :
# NEXT_PUBLIC_API_BASE_URL, SEED_ADMIN_EMAIL, SEED_ADMIN_PASSWORD, WEB_PORT.
# Ce fichier liste toutes les variables nécessaires au projet ; au bootstrap
# (Foundation), elles seront réparties entre apps/api/.env (backend) et
# apps/web/.env.local (frontend, préfixe NEXT_PUBLIC_ uniquement).
# ──────────────────────────────────────────────────────────────

# --- apps/api (backend NestJS) ---
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://aponga:aponga_dev@localhost:5432/aponga_lms?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=CHANGE_ME_LOCAL_ONLY
CORS_ORIGINS=http://localhost:3001
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
STREAM_ACCOUNT_ID=
STREAM_API_TOKEN=
EMAIL_PROVIDER=
EMAIL_FROM=

# Seed de développement (première Administrator — voir 03_TASKS/01_DATA_MODEL.md).
# Jamais de valeur en dur dans le code, jamais ces valeurs par défaut en production.
SEED_ADMIN_EMAIL=admin@aponga.local
SEED_ADMIN_PASSWORD=CHANGE_ME_LOCAL_ONLY

# --- apps/web (frontend Next.js) ---
# Port de développement : 3001, cohérent avec CORS_ORIGINS ci-dessus.
WEB_PORT=3001
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
